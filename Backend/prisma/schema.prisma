generator client {
  provider = "prisma-client"
  runtime = "cloudflare"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Category{
  id Int @id @default(autoincrement())
  CategoryName String  @default("no category")
  //store the id form the link field 
  links Link[] //this means a category can be linked to many links in the Link category
}
model Link{
  id Int @id @default(autoincrement())
  url String
  Name String
  Description String? //it means this filed is optional
  category Category @relation(fields: [CategoryId], references: [id])
  CategoryId Int
  createdAt DateTime @default(now())

}

model Note{
  id Int @id @default(autoincrement())
  title String
  content String ?
  notecategory Notecategory @relation(fields: [notecategoryId], references: [id])
  notecategoryId Int

}

model Notecategory{
  id Int @id @default(autoincrement())
  category String @default("general")
  notes Note[]

}